{
  "name": "brainctl",
  "version": "0.1.15",
  "description": "CLI environment manager for consistent AI workflows",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rorogogogo/brainctl.git"
  },
  "homepage": "https://github.com/Rorogogogo/brainctl#readme",
  "bugs": {
    "url": "https://github.com/Rorogogogo/brainctl/issues"
  },
  "bin": {
    "brainctl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "cli",
    "ai",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "commander": "^14.0.1",
    "fastmcp": "^4.0.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "picocolors": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-fast-marquee": "^1.6.5",
    "sonner": "^2.0.7",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "jose": "6.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
